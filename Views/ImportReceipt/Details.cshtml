@model DemoMVC.Models.ImportReceipt

@{
    ViewData["Title"] = "Chi tiết phiếu nhập #" + Model.Id;
}

<h2>@ViewData["Title"]</h2>
<div class="card">
    <div class="card-header bg-dark text-white">
        Thông tin chung
    </div>
    <div class="card-body">
        <p><strong>Ngày nhập:</strong> @Model.ReceiptDate.ToString("dd/MM/yyyy HH:mm")</p>
        <p><strong>Ghi chú:</strong> @Model.Note</p>
        <p><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") VNĐ</span></p>
    </div>
</div>

<h3 class="mt-4">Danh sách thiết bị trong phiếu</h3>
<table class="table table-bordered">
    <thead>
        <tr>
            <th>Thiết bị</th>
            <th>Số lượng</th>
            <th>Đơn giá</th>
            <th>Thành tiền</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.ImportDetails!)
        {
            <tr>
                <td>@item.Equipment?.Name</td>
                <td>@item.Quantity</td>
                <td>@item.UnitPrice.ToString("N0")</td>
                <td>@item.LineTotal.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>

<a asp-action="Index" class="btn btn-secondary">Quay lại danh sách</a>