@model DemoMVC.ViewModels.PagedResult<DemoMVC.Models.Student>

<table class="table table-bordered table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Tên Sinh Viên</th>
            <th>Tuổi</th>
            <th>Địa chỉ</th>
            <th>Khoa</th>
            <th class="text-center" style="width: 150px;">Hành động</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Items != null && Model.Items.Any())
        {
            foreach (var item in Model.Items)
            {
                <tr>
                    <td class="fw-bold text-muted">@item.Id</td>
                    <td class="fw-bold text-primary">@item.Name</td>
                    <td>@item.Age</td>
                    <td>@item.Address</td>
                    <td>@(item.Faculty?.FacultyName ?? "Chưa xếp khoa")</td>
                    <td class="text-center">
                        <button class="btn btn-sm btn-warning btn-edit" data-id="@item.Id">Sửa</button>
                        <button class="btn btn-sm btn-danger btn-delete" data-id="@item.Id">Xóa</button>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr><td colspan="6" class="text-center py-4">Chưa có dữ liệu sinh viên.</td></tr>
        }
    </tbody>
</table>

@if (Model.TotalItems > 0)
{
    <div class="d-flex justify-content-between align-items-center mt-3">
        <div class="text-muted">
            Hiển thị từ @((Model.CurrentPage - 1) * Model.PageSize + 1) 
            đến @(Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalItems)) 
            trong tổng số <strong>@Model.TotalItems</strong> sinh viên
        </div>
        <nav>
            <ul class="pagination mb-0">
                @for (int i = 1; i <= Math.Ceiling((double)Model.TotalItems / Model.PageSize); i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link btn-pagination" href="javascript:void(0)" data-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
}