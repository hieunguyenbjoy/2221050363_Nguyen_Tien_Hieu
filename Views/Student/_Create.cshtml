@model DemoMVC.Models.Student

<div class="modal fade" id="studentModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Thêm Sinh Viên Mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="frmCreate">
                    @Html.AntiForgeryToken() 

                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Sinh Viên</label>
                        <input type="text" class="form-control" name="Name" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tuổi</label>
                        <input type="number" class="form-control" name="Age" min="18" value="18" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Địa chỉ</label>
                        <input type="text" class="form-control" name="Address" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Khoa</label>
                        <select class="form-control" name="FacultyId" asp-items="ViewBag.Faculties"></select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-success" id="btnSaveCreate">Lưu Sinh Viên</button>
            </div>
        </div>
    </div>
</div>